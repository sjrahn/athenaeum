{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": [
      "bun"
    ],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@ath/*": [
        "./packages/*/src/index.ts"
      ],
      "@ath/contracts/*": [
        "./packages/contracts/src/*"
      ],
      "@ath/kit/*": [
        "./packages/kit/src/*"
      ],
      "@ath/engine/*": [
        "./packages/engine/src/*"
      ],
      "@ath/custody/*": [
        "./packages/custody/src/*"
      ],
      "@ath/scanner/*": [
        "./packages/scanner/src/*"
      ],
      "@ath/verbs/*": [
        "./packages/verbs/src/*"
      ],
      "@ath/daemon/*": [
        "./packages/daemon/src/*"
      ],
      "@ath/cli/*": [
        "./packages/cli/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "test",
    "types.d.ts"
  ]
}
