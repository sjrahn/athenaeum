# Member repos — independent git repos managed via athenaeum.yaml, never tracked here.
# Anchored to the root: unanchored `ledger/` also swallowed tools/src/ledger (a whole
# package silently untracked — found in the 2026-07-03 critical pass).
/corpus/
/ledger/

# macOS Finder metadata
.DS_Store

# tools (Python) build/venv/cache
tools/.venv/
tools/dist/
tools/build/
tools/**/__pycache__/
tools/**/*.egg-info/
tools/.pytest_cache/
tools/.ruff_cache/

# Deployment state — the manifest and the default tracker snapshot live at the
# workspace root but belong to the deployment, never to this repo (spec Part I §2.2 v16).
/athenaeum.yaml
/tickets.md
/athenaeum.code-workspace
