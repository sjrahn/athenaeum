# Member repos — independent git repos managed via athenaeum.yaml, never tracked here
corpora/
codices/

# Xcode / Apple clients (see APPLE-CLIENT-PLAN.md)
clients/**/xcuserdata/
clients/**/DerivedData/
clients/**/*.xcuserstate
clients/**/.build/
clients/**/*.xcodeproj/project.xcworkspace/xcuserdata/
clients/**/*.xcodeproj/xcuserdata/

# macOS Finder metadata
.DS_Store

# tools/corpus (Python) build/venv/cache
tools/corpus/.venv/
tools/corpus/dist/
tools/corpus/build/
tools/corpus/**/__pycache__/
tools/corpus/**/*.egg-info/
tools/corpus/.pytest_cache/
tools/corpus/.ruff_cache/

# web (Angular) — node deps + build output (web/ source IS tracked)
web/node_modules/
web/dist/
web/.angular/

# vendored agent skills (re-installable: npx skills add https://github.com/angular/skills)
.agents/
.claude/skills/angular-developer
.claude/skills/angular-new-app
skills-lock.json
